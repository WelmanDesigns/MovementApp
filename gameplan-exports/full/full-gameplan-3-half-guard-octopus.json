    {
      "id": "ebg-clear-crossface",
      "type": "transition",
      "label": "Clear Crossface to Octopus",
      "notes": [
        {
          "text": "They drive the crossface arm across without controlling your hips - or they pass/flatten the knee shield and start settling chest-to-chest: do not concede side control. Keep the leg trapped in half guard, clear the arm past your head, sit up, wrap the far lat or belt.",
          "createdAt": "2026-07-12T21:19:39.060Z"
        }
      ],
      "links": [],
