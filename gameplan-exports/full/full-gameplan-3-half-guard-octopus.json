    },
    {
      "id": "ebg-octopus-wrestle-up",
      "type": "transition",
      "label": "Octopus Wrestle-Up",
      "notes": [
        {
          "text": "When they pull away, raise hips or start standing: maintain waist/belt control, post the free hand, head higher than theirs, release the leg only when you can stand, come up behind their hips or onto a single leg. Same wrestle-up movement as your SLX stand-up and collar-drag systems - one movement, several guards.",
          "createdAt": "2026-07-12T21:19:39.060Z"
        }
      ],
      "links": [],
      "tags": [
        "sweep"
      ],
      "aliases": [],
      "variantOf": null,
      "category": "Sweeps",
      "fromPositionId": "ebg-octopus",
      "toPositionId": "seed-headquarters"
    },
    {
      "id": "ebg-octopus-butterfly-sweep",
      "type": "transition",
      "label": "Octopus Butterfly Sweep",
      "notes": [
        {
          "text": "Secondary (add after the first three attacks work). When they widen the base to stop the hip bump: insert the inside hook, stay attached at the waist, fall toward the posting side, elevate the far thigh, follow up immediately.",
          "createdAt": "2026-07-12T21:19:39.060Z"
        }
      ],
      "links": [],
