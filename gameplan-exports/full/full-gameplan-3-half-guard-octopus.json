      "id": "ebg-hip-switch-entry",
      "type": "transition",
      "label": "Hip-Switch Octopus Entry",
      "notes": [
        {
          "text": "They hip-switch, reverse-kesa or back-step to pass without controlling your upper body: keep the leg trapped, sit up behind their shoulder line.",
          "createdAt": "2026-07-12T21:19:39.060Z"
        }
      ],
