    {
      "id": "seed-de-la-riva",
      "type": "position",
      "label": "De La Riva",
      "notes": [
        {
          "text": "Keep it SHALLOW - deep DLR demands hip rotation, hamstring tolerance and inversion that do not fit your attributes. Weight forward -> sideways sweep; controlled leg moves back -> stand-up foot sweep; sits back -> lapel sweep; posts a hand after being pulled -> SLX; knee-cuts or drops a hip beside you -> Octopus.",
          "createdAt": "2026-07-12T21:19:39.060Z"
        }
      ],
