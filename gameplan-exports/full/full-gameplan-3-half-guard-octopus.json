    {
      "id": "ebg-recover-knee-shield",
      "type": "transition",
      "label": "Recover Knee Shield",
      "notes": [
        {
          "text": "A branch, not a failure. When they square shoulders back in, win head height, step across your body, break the waist connection or force your shoulders down: do not cling - frame against the shoulder, bring the inside knee back across, rebuild the underhook or wait for the next hip switch. The height battle (head above their shoulder) is what keeps Octopus alive.",
          "createdAt": "2026-07-12T21:19:39.060Z"
        }
      ],
      "links": [],
      "tags": [],
      "aliases": [],
      "variantOf": null,
      "category": "Octopus",
      "fromPositionId": "ebg-octopus",
      "toPositionId": "seed-knee-shield"
    },
    {
      "id": "ebg-octopus-back-take",
      "type": "transition",
      "label": "Octopus Back Take",
      "notes": [
        {
          "text": "Priority 1 - when they turn farther away, lift the near arm, pull out of the wrap, or straighten the trapped knee. Climb your chest higher behind their shoulder, control the far hip or belt, bring your bottom knee behind them, chair-sit or drag their hips toward you, seatbelt. Do NOT throw both hooks immediately if it breaks chest-to-back connection.",
          "createdAt": "2026-07-12T21:19:39.060Z"
        }
      ],
      "links": [],
      "tags": [
        "back-take"
      ],
      "aliases": [],
      "variantOf": null,
      "category": "Back takes",
      "fromPositionId": "ebg-octopus",
      "toPositionId": "seed-back-control"
    },
    {
      "id": "ebg-kosoto-hip-bump",
      "type": "transition",
      "label": "Kosoto Hip-Bump Sweep",
      "notes": [
        {
          "text": "Primary reversal - when they stay low, drive backward into you, post the far hand or base toward the trapped leg. Outside foot behind their far ankle or calf, post your free hand, raise your hips, pull their upper body toward the wrapping arm, drive the lower body the opposite way. Land in Half Guard Top -> crossface + underhook -> pressure pass.",
          "createdAt": "2026-07-12T21:19:39.060Z"
        }
      ],
      "links": [],
      "tags": [
        "sweep"
      ],
      "aliases": [],
      "variantOf": null,
      "category": "Sweeps",
      "fromPositionId": "ebg-octopus",
      "toPositionId": "seed-half-guard-top"
    },
    {
      "id": "ebg-butterfly-octopus",
      "type": "position",
      "label": "Butterfly Octopus",
      "notes": [
        {
          "text": "Add only after the back take, kosoto and wrestle-up already work. Inside butterfly hook while staying attached around their waist.",
          "createdAt": "2026-07-12T21:19:39.060Z"
        }
      ],
      "links": [],
      "tags": [
        "bottom"
      ],
      "aliases": [],
