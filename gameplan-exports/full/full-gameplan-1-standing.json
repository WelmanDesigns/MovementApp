      "type": "transition",
      "label": "Guard Pull",
      "notes": [
        {
          "text": "Guard pulls established guard 94% of the time at lower belts - but only pull when you land somewhere useful: they stay standing -> Shallow DLR or shin-to-shin; they kneel -> knee shield; they hip-switch immediately -> Octopus.",
          "createdAt": "2026-07-12T21:19:39.060Z"
        }
      ],
